msgstr "ჩაშენებული ეკრანი"

msgctxt "@label unknown monitor"
msgid "Monitor"
msgstr "მონიტორი"

msgctxt "%1 is a monitor name, %2 is its connector or identifier"
msgid "%1 (%2)"
msgstr "%1 (%2)"

msgid "All monitors"
msgstr "ყველა მონიტორი"

msgid "All HDR monitors"
